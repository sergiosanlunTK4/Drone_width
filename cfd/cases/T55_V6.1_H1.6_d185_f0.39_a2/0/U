FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (6.074 0 0);
boundaryField
{
    inlet   { type fixedValue;  value uniform (6.074 0 0); }
    outlet  { type inletOutlet; inletValue uniform (6.074 0 0); value uniform (6.074 0 0); }
    sides   { type slip; }
    top     { type slip; }
    ground  { type noSlip; }
}
