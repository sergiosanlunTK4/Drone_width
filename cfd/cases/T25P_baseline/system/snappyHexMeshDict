FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

geometry
{
    T25P_control.stl
    {
        type triSurfaceMesh;
        name T25P_control;
    }
}

castellatedMesh true;
snap            true;
addLayers       true;

castellatedMeshControls
{
    maxLocalCells       100000;
    maxGlobalCells      500000;
    minRefinementCells  10;
    nCellsBetweenLevels 3;

    features
    (
    );

    refinementSurfaces
    {
        T25P_control
        {
            level (1 2);

            patchInfo
            {
                type wall;
            }
        }
    }

    refinementRegions
    {
    }

    resolveFeatureAngle 30;

    allowFreeStandingZoneFaces false;

    locationInMesh (0 0 3);
}

snapControls
{
    nSmoothPatch 5;
    tolerance    1.0;
    nSolveIter   100;
    nRelaxIter   5;
}

addLayersControls
{
    relativeSizes true;
    layers
    {
        T25P_control
        {
            nSurfaceLayers 4;
        }
    }

    expansionRatio          1.2;
    finalLayerThickness     0.05;
    minThickness            0.01;

    nGrow                   0;

    featureAngle            60;

    nRelaxIter              5;
    nSmoothSurfaceNormals   1;
    nSmoothNormals          3;
    nSmoothThickness        10;

    maxFaceThicknessRatio       0.5;
    maxThicknessToMedialRatio   0.3;
    minMedialAxisAngle          90;

    nBufferCellsNoExtrude   0;
    nLayerIter              50;
}

meshQualityControls
{
    maxNonOrtho             65;
    maxBoundarySkewness     20;
    maxInternalSkewness     2.5;
    maxConcave              80;

    minFlatness             0.5;
    minVol                  1e-13;
    minTetQuality           -1;
    minArea                 -1;

    minTwist                0.02;
    minTriangleTwist        -1;
    minDeterminant          0.001;
    minFaceWeight           0.05;
    minVolRatio             0.01;

    nSmoothScale            4;
    errorReduction          0.75;
}

debug 0;

mergeTolerance 1e-6;
