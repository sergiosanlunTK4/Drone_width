FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.14879025;
boundaryField
{
    inlet   { type fixedValue;  value uniform 0.14879025; }
    outlet  { type inletOutlet; inletValue uniform 0.14879025; value uniform 0.14879025; }
    sides   { type slip; }
    top     { type slip; }
    ground  { type kqRWallFunction; value uniform 0.14879025; }
}
