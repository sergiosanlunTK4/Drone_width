FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2000;
deltaT          1;
writeControl    timeStep;
writeInterval   100;
purgeWrite      3;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    // plano receptor a la altura del suelo: D(x,y) se integra aqui
    receptorPlane
    {
        type            surfaces;
        libs            ("libsampling.so");
        surfaceFormat   raw;
        fields          (U p k omega);
        interpolationScheme cellPoint;
        surfaces
        {
            ground
            {
                type        plane;
                planeType   pointAndNormal;
                pointAndNormalDict
                {
                    point   (0 0 -1.694);
                    normal  (0 0 1);
                }
                triangulate false;
            }
        }
    }

    // lineas verticales: perfil de downwash u(z) bajo cada rotor
    downwashLines
    {
        type            sets;
        libs            ("libsampling.so");
        writeControl    timeStep;
        writeInterval   100;
        interpolationScheme cellPoint;
        setFormat       raw;
        fields          (U k omega);
        sets
        {
            line_under_rotor1
            {
                type        uniform;
                axis        z;
                start       (0.8627 0.8627 -1.684);
                end         (0.8627 0.8627 1.0);
                nPoints     60;
            }
        }
    }

    // residuos y fuerzas en el disco
    forces
    {
        type            forces;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   20;
        patches         (ground);
        rho             rhoInf;
        rhoInf          1.1716;
        CofR            (0 0 0);
    }
}
