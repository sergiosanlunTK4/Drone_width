    }

    // rotor4: T_i = 127.270000 N (fuerza del rotor sobre el UAV, hacia arriba)
    //     V_zone = 5.2914062504e-01 m3  ->  Su = F_aire/V_zone = (0.0000000000e+00 0.0000000000e+00 -2.4052207292e+02) N/m3
    rotor4
