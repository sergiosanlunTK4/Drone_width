FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 102.32247;
boundaryField
{
    inlet   { type fixedValue;  value uniform 102.32247; }
    outlet  { type inletOutlet; inletValue uniform 102.32247; value uniform 102.32247; }
    sides   { type slip; }
    top     { type slip; }
    ground  { type kqRWallFunction; value uniform 102.32247; }
}
