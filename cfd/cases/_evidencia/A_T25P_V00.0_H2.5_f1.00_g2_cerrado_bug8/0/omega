FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 7.39715;
boundaryField
{
    inlet    { type slip; }
    outlet   { type slip; }
    sides    { type slip; }
    top      { type slip; }
    ground   { type omegaWallFunction; value uniform 7.39715; }
    airframe { type omegaWallFunction; value uniform 7.39715; }
}
