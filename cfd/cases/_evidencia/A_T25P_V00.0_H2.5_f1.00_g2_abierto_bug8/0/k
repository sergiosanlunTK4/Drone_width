internalField   uniform 0.164154;
boundaryField
{
    inlet    { type inletOutlet; inletValue uniform 0.164154; value uniform 0.164154; }
    outlet   { type inletOutlet; inletValue uniform 0.164154; value uniform 0.164154; }
    sides    { type inletOutlet; inletValue uniform 0.164154; value uniform 0.164154; }
    top      { type inletOutlet; inletValue uniform 0.164154; value uniform 0.164154; }
    ground   { type kqRWallFunction; value uniform 0.164154; }
    airframe { type kqRWallFunction; value uniform 0.164154; }
}
