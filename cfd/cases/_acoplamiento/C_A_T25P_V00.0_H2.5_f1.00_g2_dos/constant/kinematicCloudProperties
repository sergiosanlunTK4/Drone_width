            position        (-0.68075 -0.71087 -0.30498);
            direction       (-0.02511 -0.029036 -0.9992629);
            parcelsPerSecond 20000;
            flowRateProfile constant 1;
            thetaInner      constant 85;
            thetaOuter      constant 90;
            sizeDistribution
            {
                type        RosinRammler;
                RosinRammlerDistribution { lambda 0.0001; n 3.0; minValue 2e-05; maxValue 0.0004; }
            }
        }
