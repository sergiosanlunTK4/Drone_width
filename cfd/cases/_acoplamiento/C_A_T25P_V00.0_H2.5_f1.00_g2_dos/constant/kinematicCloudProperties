            injectionMethod disc;
            flowType        constantVelocity;
            UMag            43.98;
            outerDiameter   0.06;
            innerDiameter   0.054;
            position        (-0.68075 0.71087 -0.30498);
            direction       (-0.02511 0.029036 -0.9992629);
            parcelsPerSecond 20000;
            flowRateProfile constant 1;
            thetaInner      constant 85;
            thetaOuter      constant 90;
            sizeDistribution
            {
                type        RosinRammler;
                RosinRammlerDistribution { lambda 0.0001; n 3.0; minValue 2e-05; maxValue 0.0004; }
            }
        }
        N2_RR
        {
            type            coneNozzleInjection;
            SOI             0;
            duration        2.0;
            massTotal       0.39848;
            parcelBasisType mass;
            injectionMethod disc;
            flowType        constantVelocity;
            UMag            43.98;
            outerDiameter   0.06;
