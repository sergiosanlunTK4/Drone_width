# --- Datos crudos aportados por el investigador (inmutables, no versionar binarios grandes)
data/*.pdf

# --- Extracciones y material de terceros
#     Los .txt extraidos de los PPTX y el volcado de imagenes son regenerables con
#     scripts/extract_pptx_text.py y scripts/extract_pptx_media.py.
#     SI se versionan: data/processed/media_inventory.csv (catalogo) y
#     figures/contact_sheets/ (derivados, utiles para revision).
data/raw/dji_academy_*.txt
data/raw/media/
# el render PNG del diagrama se regenera con scripts/convert_vector_media.py
data/raw/media_converted/
# capturas de fichas oficiales: el HTML crudo se regenera con scripts/capture_official_specs.py;
# SI se versionan el manifiesto con hashes, el informe y las tablas estructuradas
data/raw/specs_captures/*.html

# --- Casos CFD: la malla y los campos son regenerables desde los diccionarios.
#     Se versionan los diccionarios (system/, constant/*.dict, 0/), NO la malla ni los resultados.
cfd/cases/*/constant/polyMesh/
cfd/cases/*/constant/extendedFeatureEdgeMesh/
# el STL/triSurface del caso es regenerable desde geometry/models/
cfd/cases/*/constant/triSurface/
cfd/cases/*/0/polyMesh/
cfd/cases/*/0/pointLevel
cfd/cases/*/0/cellLevel
cfd/cases/*/[1-9]*/
cfd/cases/*/[1-9]*.*/
cfd/cases/*/postProcessing/
cfd/cases/*/log.*
cfd/cases/*backup*/
cfd/results/

# --- Entornos y temporales
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- Temporales de trabajo (renders de PDF, recortes, pruebas visuales)
#     No son producto de investigacion: son material de trabajo intermedio.
tmp/
scratch_*.png

# --- Sistema operativo / macOS
.DS_Store
._*
Thumbs.db

# --- Salidas grandes de post-proceso
*.foam
*.vtk
*.vtu
*.vtp
*.raw
*.h5
*.hdf5
